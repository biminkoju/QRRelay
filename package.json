{
  "name": "qrrelay",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline two-way optical file transfer over QR codes",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "build": "npm run typecheck && vite build && vite build --mode single && npm run check:no-remote && npm run release:checksums",
    "build:pwa": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview --port 4173 --strictPort",
    "preview:single": "vite preview --mode single --outDir dist-single --port 4174 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:no-remote": "node build/check-no-remote.mjs",
    "release:checksums": "node build/write-checksums.mjs",
    "serve:prefix": "node build/serve-prefix.mjs dist /qrrelay/ 4175"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "22.13.1",
    "typescript": "5.7.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "nayuki-qr-code-generator": "1.8.0"
  }
}
